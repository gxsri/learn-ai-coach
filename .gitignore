# ══════════════════════════════════════════════════════════════════
#  .gitignore —— 让仓库只装"人和 AI 写的代码与文档"，
#                不装环境、不装权重、不装你自己的视频
# ══════════════════════════════════════════════════════════════════

# ── Python 环境 ───────────────────────────────────────────────────
# ⚠️ .venv 有 4.7 GB，是必须排除的第一号目标
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ── 模型权重 ──────────────────────────────────────────────────────
# 首次运行 YOLO 会自动下载（约 7.5 MB），不需要进仓库
*.pt
*.pth
*.onnx
*.engine
*.tflite

# ── 运行产物 ──────────────────────────────────────────────────────
# 全部可以由这几条命令重新生成：
#   run.cmd make_demo_session.py
#   run.cmd 02_extract_pose.py --video ... --session ...
#   run.cmd 03_events_and_metrics.py --session ...
#   run.cmd 04_report.py --session ...
#
# 想留一份示例给人看？放到 starter/examples/ 下（那个目录会被提交）
outputs/
outputs_old/
starter/outputs/
starter/outputs_old/

# ── 视频素材 ──────────────────────────────────────────────────────
# ① 第三方示例视频：不随仓库分发，下载方式见 starter/testdata/README.md
# ② 你自己拍的羽毛球视频：体积大，而且不该公开
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv

# ── 编辑器 / 系统 ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
desktop.ini
.DS_Store

# ── 调试残留 ──────────────────────────────────────────────────────
*.log
_check_*.png
DEBUG.md
